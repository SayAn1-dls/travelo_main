MONGO_URL=mongodb://localhost:27017
DB_NAME=travelo
JWT_SECRET=change-me
# --- AI: NOMAD chat, voice transcription (Whisper), guides, vibe lab. Set ONE of these.
# Without a key NOMAD still answers using the built-in destination knowledge.
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
EMERGENT_LLM_KEY=
# --- Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Admin account (seeded on startup; leave blank to disable)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# --- Email (trip invites, receipts). Create a Gmail App Password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Public URL of the site, used in invite links (a friend can't open http://localhost:3000)
APP_URL=
